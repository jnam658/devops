pipeline {
    agent any

    environment {
        JUNIT_JAR_URL = 'https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/1.7.1/junit-platform-console-standalone-1.7.1.jar'
        JUNIT_JAR_PATH = 'lib/junit.jar'
        CLASS_DIR = 'classes'
        REPORT_DIR = 'test-reports'
        MAIL_TO = 'jnam658@g.hongik.ac.kr'
    }

    stages {
        stage('Prepare') {
            steps {
                dir('test1') {
                    sh '''
                        mkdir -p ${CLASS_DIR}
                        mkdir -p ${REPORT_DIR}
                        mkdir -p lib
                        echo "[+] Downloading JUnit JAR..."
                        curl -L -o ${JUNIT_JAR_PATH} ${JUNIT_JAR_URL}
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                dir('test1') {
                    sh '''
                        echo "[+] Compiling source files..."
                        find src -name "*.java" > sources.txt
                        javac -encoding UTF-8 -d ${CLASS_DIR} -cp ${JUNIT_JAR_PATH} @sources.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('test1') {
                    sh '''
                        echo "[+] Running tests with JUnit..."

                        java -jar ${JUNIT_JAR_PATH} \
                             --class-path ${CLASS_DIR} \
                             --scan-class-path \
                             --details=tree \
                             --details-theme=ascii \
                             --reports-dir ${REPORT_DIR} \
                             --config=junit.platform.output.capture.stdout=true \
                             --config=junit.platform.reporting.open.xml.enabled=true \
                             > ${REPORT_DIR}/test-output.txt

                        cat ${REPORT_DIR}/test-output.txt
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "test1/${REPORT_DIR}/**/*", allowEmptyArchive: true

            script {
                def testOutput = "테스트 출력 파일을 찾지 못했습니다."

                if (fileExists("test1/${REPORT_DIR}/test-output.txt")) {
                    testOutput = readFile("test1/${REPORT_DIR}/test-output.txt")
                }

                def resultText = currentBuild.currentResult

                emailext(
                    to: "${MAIL_TO}",
                    subject: "Jenkins Build ${resultText}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """
[Jenkins 빌드 결과]

결과: ${resultText}
Job 이름: ${env.JOB_NAME}
Build 번호: #${env.BUILD_NUMBER}
Build URL: ${env.BUILD_URL}

[Git 정보]

Branch: ${env.BRANCH_NAME ?: 'master'}
Commit: ${env.GIT_COMMIT ?: 'N/A'}

[JUnit 테스트 결과]

${testOutput}

[첨부/보관 파일]

Jenkins 빌드 페이지에서 test-reports 결과 파일을 확인할 수 있습니다.
${env.BUILD_URL}
"""
                )
            }
        }
    }
}